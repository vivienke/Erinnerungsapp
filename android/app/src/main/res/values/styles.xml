<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!--
        Recolours the native date/time dialogs of
        @capawesome-team/capacitor-datetime-picker.

        The plugin ships these two styles as empty shells; app resources take
        precedence over library resources with the same name, so redefining them
        here (with the same parent) applies the app's blue to the selected day,
        the clock hand and the dialog buttons. The plugin's *.StyleSpinner
        variants inherit from these two, so they follow automatically.
    -->
    <style name="MaterialLightTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/pickerAccentLight</item>
    </style>

    <style name="MaterialDarkTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/pickerAccentDark</item>
    </style>
</resources>